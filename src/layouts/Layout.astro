---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  calendly?: boolean;
  /** Link preview image, 1200x630, generated by scripts/make-og-images.mjs */
  image?: string;
  imageAlt?: string;
  /** Schema.org structured data, rendered as JSON-LD */
  jsonLd?: Record<string, unknown>;
}
const {
  title = 'Faloe — Cinema is passed down by hand.',
  description = 'Faloe is a workshop, an expedition, and a production studio for working storytellers. Built on craft. New York.',
  calendly = false,
  image = '/og/faloe.jpg',
  imageAlt = 'A film crew applauding together on the last day of a shoot in Genoa.',
  jsonLd,
} = Astro.props;

// Canonical: always non-www HTTPS, using the site root defined in astro.config.mjs
const canonicalURL = new URL(Astro.url.pathname, 'https://faloefoundry.com');
// Link previews need an absolute image URL, not a site-relative path
const imageURL = new URL(image, 'https://faloefoundry.com');

// Content Security Policy. GitHub Pages cannot send response headers, so the
// policy ships as a meta tag. Two things cannot be set this way and would need
// real headers: frame-ancestors (clickjacking) and HSTS.
//
// The build emits every script and stylesheet as a file, so no inline <script>
// or <style> elements exist and script-src can stay at a plain 'self'.
// style-src needs 'unsafe-inline' for the inline style attributes used
// throughout the pages; it works only because no hashes appear in the
// directive, since a hash would make browsers ignore 'unsafe-inline'.
//
// Calendly is the only third-party code on the site. It loads on the one page
// that embeds it, and only that page widens its own policy to allow it.
const calendlySource = calendly ? ' https://assets.calendly.com' : '';
const csp = [
  "default-src 'self'",
  `script-src 'self'${calendlySource}`,
  `style-src 'self' 'unsafe-inline'${calendlySource}`,
  // data: covers the grain texture SVG in global.css
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "base-uri 'self'",
  // Nothing on the site posts a form. The roadmap field is handled in JS.
  "form-action 'none'",
  "object-src 'none'",
  calendly ? 'frame-src https://calendly.com' : "frame-src 'none'",
].join('; ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="content-security-policy" content={csp} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Link previews, used when the site is shared in a message or a post -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Faloe Foundry" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL.href} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    {calendly && (
      <>
        <!-- Calendly scheduling widget, loaded only on the page that embeds it -->
        <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
        <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async is:inline></script>
      </>
    )}
  </head>
  <body class="bg-black min-h-screen">
    <slot />
  </body>
</html>
