---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Book a Consultation — Faloe Foundry"
  description="Schedule a creative alignment consultation with Jonathan Whittaker, founder of Faloe Foundry."
>

  <!-- ─── NAV ─────────────────────────────────────────── -->
  <header class="fixed top-0 left-0 right-0 z-50 px-6 md:px-16 lg:px-24 xl:px-32 py-6 md:py-7 flex items-center justify-between" style="background: linear-gradient(to bottom, rgba(0,0,0,0.98) 0%, rgba(0,0,0,0.85) 80%, transparent 100%); backdrop-filter: blur(4px);">
    <a href="/" class="text-[#fdfcf8] uppercase select-none" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 22px; font-weight: 400; letter-spacing: 0.3em;">
      Faloe
    </a>
    <a
      href="/"
      class="text-[9px] md:text-[10px] uppercase font-light text-[#c8c5bc] hover:text-[#fdfcf8] transition-colors duration-300"
      style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.06em;"
    >
      ← Back
    </a>
  </header>

  <!-- ─── MAIN ──────────────────────────────────────────── -->
  <main class="min-h-screen px-8 md:px-16 lg:px-24 xl:px-32 pt-40 pb-32">

    <!-- Header -->
    <div class="max-w-2xl mb-16">

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-10 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        Faloe Foundry &nbsp;&middot;&nbsp; Creative Alignment
      </p>

      <h1
        class="font-light text-[#fdfcf8] leading-[0.95] mb-10"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.5rem, 5vw, 4rem); letter-spacing: -0.03em;"
      >
        Book a Consultation.
      </h1>

      <div class="space-y-4">
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          A direct conversation about fit.
        </p>
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          For individuals, production teams, corporations, NGOs, and organizations
          with specific training goals. We will determine together whether Faloe
          is the right fit, and what that looks like.
        </p>
      </div>

    </div>

    <div class="w-full h-px bg-[#fdfcf8] opacity-10 mb-16 max-w-2xl"></div>

    <!-- Calendly widget -->
    <div class="max-w-2xl">
      <div
        class="calendly-inline-widget"
        data-url="https://calendly.com/jrw-jrwhittaker/initial-consult?background_color=000000&text_color=fdfcf8&primary_color=fdfcf8"
        style="min-width:320px;height:700px;"
      ></div>
      <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
    </div>

  </main>

  <!-- ─── FOOTER ────────────────────────────────────────── -->
  <footer class="px-8 md:px-16 lg:px-24 xl:px-32 py-10 border-t border-[#fdfcf8] border-opacity-10">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <span class="text-[#fdfcf8] opacity-30" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 15px; letter-spacing: 0.2em;">
        Faloe
      </span>
      <div class="flex gap-8 text-[10px] uppercase font-light text-[#c8c5bc] opacity-30" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.2em;">
        <span>New York</span>
        <span>&copy; 2026</span>
      </div>
    </div>
  </footer>

</Layout>
