---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <!-- ─── NAV ─────────────────────────────────────────── -->
  <header class="fixed top-0 left-0 right-0 z-50 px-6 md:px-16 lg:px-24 xl:px-32 py-6 md:py-7 flex items-center justify-between" style="background: linear-gradient(to bottom, rgba(0,0,0,0.98) 0%, rgba(0,0,0,0.85) 80%, transparent 100%); backdrop-filter: blur(4px);">
    <a href="/" class="text-[#fdfcf8] text-xs uppercase select-none" style="font-family: 'Cormorant Garamond', Georgia, serif; letter-spacing: 0.2em;">
      Faloe
    </a>
    <nav class="flex items-center gap-5 md:gap-10" style="font-family: 'Inter', system-ui, sans-serif;">
      <a href="#foundry"  class="text-[9px] md:text-[10px] uppercase font-light text-[#c8c5bc] hover:text-[#fdfcf8] transition-colors duration-300" style="letter-spacing: 0.06em;">Foundry</a>
      <a href="#field"    class="text-[9px] md:text-[10px] uppercase font-light text-[#c8c5bc] hover:text-[#fdfcf8] transition-colors duration-300" style="letter-spacing: 0.06em;">Field</a>
      <a href="#manifesto" class="text-[9px] md:text-[10px] uppercase font-light text-[#c8c5bc] hover:text-[#fdfcf8] transition-colors duration-300" style="letter-spacing: 0.06em;">Manifesto</a>
    </nav>
  </header>

  <!-- ─── HERO ─────────────────────────────────────────── -->
  <section class="relative min-h-screen flex flex-col justify-center px-8 md:px-16 lg:px-24 xl:px-32">

    <div class="absolute top-32 left-8 md:left-16 lg:left-24 xl:left-32 right-8 md:right-16 h-px bg-[#fdfcf8] opacity-10"></div>

    <div class="max-w-5xl pt-24 pb-32">

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-16 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        Est. 2026 &nbsp;&middot;&nbsp; New York
      </p>

      <h1
        class="font-light leading-[0.92] text-[#fdfcf8]"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(3rem, 8vw, 7.5rem); letter-spacing: -0.04em;"
      >
        Cinema is a<br />
        <span style="font-style: italic;">Human Tradition.</span><br />
        Let&rsquo;s return to it.
      </h1>

      <div class="mt-16 flex items-center gap-6">
        <div class="w-8 h-px bg-[#fdfcf8] opacity-40"></div>
        <p class="font-light text-sm text-[#c8c5bc] tracking-wide max-w-xs leading-relaxed" style="font-family: 'Inter', system-ui, sans-serif;">
          A workshop, an expedition, and a studio.<br class="hidden sm:block" /> Built on craft. Uncompromising in vision.
        </p>
      </div>

    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 opacity-30">
      <div class="w-px h-12 bg-[#fdfcf8]" style="animation: pulse 2s ease-in-out infinite;"></div>
    </div>

  </section>

  <!-- ─── PILLARS OVERVIEW ──────────────────────────────── -->
  <section id="pillars" class="px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-40 border-t border-[#fdfcf8] border-opacity-10">

    <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-20 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
      The Work
    </p>

    <div class="grid md:grid-cols-3 gap-16 md:gap-0">

      <!-- Pillar 1 -->
      <div class="md:pr-12 lg:pr-16">
        <p class="text-[9px] tracking-[0.35em] uppercase text-[#c8c5bc] mb-6 font-light opacity-60" style="font-family: 'Inter', system-ui, sans-serif;">
          I &nbsp;/&nbsp; The Labs
        </p>
        <h2 class="font-light text-[#fdfcf8] mb-6 leading-tight" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: 0.06em;">
          Faloe<br />Foundry
        </h2>
        <div class="w-5 h-px bg-[#fdfcf8] opacity-30 mb-6"></div>
        <p class="font-light text-sm text-[#c8c5bc] leading-[1.8]" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
          A workshop and intensive program for working image-makers, based in New York and online.
          Each session is led by active professionals: directors, cinematographers, editors,
          sound designers who bring living craft into the room.
        </p>
      </div>

      <!-- Pillar 2 -->
      <div class="md:px-12 lg:px-16 md:border-x border-[#fdfcf8] border-opacity-10">
        <p class="text-[9px] tracking-[0.35em] uppercase text-[#c8c5bc] mb-6 font-light opacity-60" style="font-family: 'Inter', system-ui, sans-serif;">
          II &nbsp;/&nbsp; The Expeditions
        </p>
        <h2 class="font-light text-[#fdfcf8] mb-6 leading-tight" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: 0.06em;">
          Faloe<br />Field
        </h2>
        <div class="w-5 h-px bg-[#fdfcf8] opacity-30 mb-6"></div>
        <p class="font-light text-sm text-[#c8c5bc] leading-[1.8]" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
          Cohort expeditions: equal parts cultural immersion and professional training.
          Participants don't observe. They make. The expedition is the curriculum.
          The work produced is the case study.
        </p>
      </div>

      <!-- Pillar 3 -->
      <div class="md:pl-12 lg:pl-16">
        <p class="text-[9px] tracking-[0.35em] uppercase text-[#c8c5bc] mb-6 font-light opacity-60" style="font-family: 'Inter', system-ui, sans-serif;">
          III &nbsp;/&nbsp; The Studio
        </p>
        <h2 class="font-light text-[#fdfcf8] mb-6 leading-tight" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: 0.06em;">
          Faloe
        </h2>
        <div class="w-5 h-px bg-[#fdfcf8] opacity-30 mb-6"></div>
        <p class="font-light text-sm text-[#c8c5bc] leading-[1.8]" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
          A residency program for filmmakers who need time, space, and serious collaborators.
          Work developed inside Faloe is released through our own distribution infrastructure,
          built to bring ambitious projects to audiences without compromise.
        </p>
      </div>

    </div>

  </section>

  <!-- ─── FOUNDRY ───────────────────────────────────────── -->
  <section id="foundry" class="relative px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-48 border-t border-[#fdfcf8] border-opacity-10 overflow-hidden">

    <div class="absolute inset-0 flex items-end justify-end pointer-events-none select-none pr-8 md:pr-16 pb-12 overflow-hidden" aria-hidden="true">
      <span class="font-light text-[#fdfcf8]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(6rem, 18vw, 18rem); letter-spacing: -0.04em; opacity: 0.03; line-height: 1;">01</span>
    </div>

    <div class="relative max-w-2xl">

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-16 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        Foundry &nbsp;&middot;&nbsp; The Labs &nbsp;&middot;&nbsp; Summer 2026
      </p>

      <h2
        class="font-light text-[#fdfcf8] leading-[0.95] mb-12"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.03em;"
      >
        The Lab<br />Intensives
      </h2>

      <div class="space-y-6 mb-12">
        <p class="font-light text-[#c8c5bc] text-sm leading-[2]" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
          A series of focused workshops led by working directors, cinematographers, editors,
          and sound designers. Each program is built around a single discipline and taught
          over three days with a limited cohort of twelve practitioners.
        </p>
        <p class="font-light text-[#c8c5bc] text-sm leading-[2]" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
          Sessions run in New York and online. No prerequisites. No passive observers.
          You leave with work, feedback, and a room full of people still in the practice.
        </p>
      </div>

      <div class="border-t border-[#fdfcf8] border-opacity-10 pt-8">
        <p class="font-light text-[#c8c5bc] text-xs leading-[1.8] italic" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.02em;">
          Full curriculum and intake details are currently being refined in the lab. Details to follow.
        </p>
      </div>

    </div>

  </section>

  <!-- ─── FIELD ─────────────────────────────────────────── -->
  <section id="field" class="relative px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-48 border-t border-[#fdfcf8] border-opacity-10 overflow-hidden">

    <div class="absolute inset-0 flex items-end justify-end pointer-events-none select-none pr-8 md:pr-16 pb-12 overflow-hidden" aria-hidden="true">
      <span class="font-light text-[#fdfcf8]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(6rem, 18vw, 18rem); letter-spacing: -0.04em; opacity: 0.03; line-height: 1;">02</span>
    </div>

    <div class="relative max-w-2xl">

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-16 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        Field &nbsp;&middot;&nbsp; Expedition 001
      </p>

      <h2
        class="font-light text-[#fdfcf8] leading-[0.95] mb-12"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.03em;"
      >
        Expedition 001:<br /><span style="font-style: italic;">The Interior</span>
      </h2>

      <div class="space-y-6 mb-12">
        <p class="font-light text-[#c8c5bc] text-sm leading-[2]" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
          A cohort expedition to a location chosen for its cultural depth and distance from
          the familiar. Part immersion, part professional intensive. Participants shoot, edit,
          and produce finished work in the field alongside experienced leaders.
        </p>
        <p class="font-light text-[#c8c5bc] text-sm leading-[2]" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
          The work produced becomes the case study. Twelve participants. One location.
          The expedition is the curriculum.
        </p>
      </div>

      <div class="border-t border-[#fdfcf8] border-opacity-10 pt-8">
        <p class="font-light text-[#c8c5bc] text-xs leading-[1.8] italic" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.02em;">
          Location and dates are currently in formation. This expedition is limited to twelve participants. Details to follow.
        </p>
      </div>

    </div>

  </section>

  <!-- ─── MANIFESTO ─────────────────────────────────────── -->
  <section id="manifesto" class="relative px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-48 border-t border-[#fdfcf8] border-opacity-10 overflow-hidden">

    <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none" aria-hidden="true">
      <span class="font-light text-[#fdfcf8]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(8rem, 20vw, 22rem); letter-spacing: -0.04em; opacity: 0.025;">Faloe</span>
    </div>

    <div class="relative max-w-3xl">

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-16 font-light" data-fade style="font-family: 'Inter', system-ui, sans-serif;">
        The Manifesto
      </p>

      <div class="space-y-8">

        <p class="font-light text-[#fdfcf8] leading-[1.2]" data-fade style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.5rem, 3vw, 2.25rem); letter-spacing: -0.03em;">
          We reject the premise that cinema should be optimized.
        </p>

        <p class="font-light text-[#c8c5bc] text-sm leading-[2] max-w-2xl" data-fade style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
          The first filmmakers were also technologists. They mixed their own emulsions and
          invented the grammar as they went. Every tool that followed&mdash;handheld, digital,
          virtual production&mdash;extended the same gesture: a human being deciding what to
          look at, and why.
        </p>

        <p class="font-light text-[#c8c5bc] text-sm leading-[2] max-w-2xl" data-fade style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
          The tool is not the problem. Surrendering authorship to it is. Our answer is not
          a better product; it is a different practice.
        </p>

        <p class="font-light text-[#c8c5bc] text-sm leading-[2] max-w-2xl" data-fade style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
          Craft learned in the room with people still doing it. Tested in the field under
          real conditions. Refined inside a residency that values depth over speed. This is
          how a tradition stays alive: not by being preserved, but by being taught.
        </p>

        <p class="font-light text-[#c8c5bc] text-sm leading-[2] max-w-2xl" data-fade style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
          Cinema began as an act of witness. In the gesture of pointing a lens at the world
          and pressing record, there is an implicit promise: <em>this mattered enough to hold</em>.
          We intend to honor that promise.
        </p>

        <p class="font-light text-[#c8c5bc] text-sm leading-[2] max-w-2xl" data-fade style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
          Every lens choice, every cut, every location: made because a person decided, not
          because a system suggested. The cam&eacute;ra-stylo: the camera as pen, the filmmaker
          as author.
        </p>

        <div data-fade>
          <p class="font-light text-[#c8c5bc] text-sm leading-[2] max-w-2xl mb-6" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
            Not virality. Not velocity.
          </p>
          <p class="font-semibold text-[#fdfcf8] leading-[0.92]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.04em;">
            The frame<br />that endures.
          </p>
        </div>

        <div class="pt-4 flex items-center gap-6" data-fade>
          <div class="w-8 h-px bg-[#fdfcf8] opacity-20"></div>
          <p class="text-[#fdfcf8] opacity-50 text-sm tracking-wide" style="font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic;">
            Faloe &nbsp;&middot;&nbsp; 2026
          </p>
        </div>

      </div>
    </div>

  </section>

  <!-- ─── CONTACT ──────────────────────────────────────── -->
  <section id="contact" class="px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-40 border-t border-[#fdfcf8] border-opacity-10">

    <div class="max-w-xl">

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-12 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        Connect
      </p>

      <h2 class="font-light text-[#fdfcf8] mb-8 leading-[0.95]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.5rem, 5vw, 4.5rem); letter-spacing: -0.03em;">
        Start a<br />Conversation.
      </h2>

      <p class="font-light text-sm text-[#c8c5bc] leading-[1.8] mb-12 max-w-sm" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: -0.01em;">
        Whether you are a prospective student, a potential collaborator, or a partner
        exploring what Faloe might make possible: we would like to hear from you.
      </p>

      <a
        href="https://calendly.com/placeholder"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block text-[#fdfcf8] text-sm font-light hover:opacity-60 transition-opacity duration-300"
        style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.08em; text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px;"
      >
        SCHEDULE A TIME
      </a>

    </div>

  </section>

  <!-- ─── FOOTER ────────────────────────────────────────── -->
  <footer class="px-8 md:px-16 lg:px-24 xl:px-32 py-12 border-t border-[#fdfcf8] border-opacity-10">

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
      <span class="text-[#fdfcf8] opacity-30 text-sm" style="font-family: 'Cormorant Garamond', Georgia, serif; letter-spacing: 0.15em;">
        Faloe
      </span>
      <div class="flex gap-8 text-[10px] uppercase font-light text-[#c8c5bc] opacity-30" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.2em;">
        <span>New York</span>
        <span>&copy; 2026</span>
      </div>
    </div>

    <div class="border-t border-[#fdfcf8] border-opacity-5 pt-8">
      <p class="text-[10px] font-light text-[#c8c5bc] opacity-40 leading-[1.8] max-w-lg" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.02em;">
        <span class="uppercase" style="letter-spacing: 0.15em;">In Network</span>
        &nbsp;&mdash;&nbsp;
        Strategic partnerships with industry-leading post-production houses and virtual stages are currently under finalization.
      </p>
    </div>

  </footer>

</Layout>

<style>
  section[id] {
    scroll-margin-top: 80px;
  }

  [data-fade] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.9s ease, transform 0.9s ease;
  }
  [data-fade].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const form = document.getElementById('email-form') as HTMLFormElement;
  const msg  = document.getElementById('form-message') as HTMLElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = form.querySelector('input[type="email"]') as HTMLInputElement;
    msg.style.opacity = '1';
    input.value = '';
    setTimeout(() => { msg.style.opacity = '0'; }, 4000);
  });

  const fadeEls = document.querySelectorAll('[data-fade]');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = el.dataset.fadeDelay ?? '0';
          el.style.transitionDelay = delay;
          el.classList.add('is-visible');
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.15 }
  );

  fadeEls.forEach((el, i) => {
    (el as HTMLElement).dataset.fadeDelay = `${i * 120}ms`;
    observer.observe(el);
  });
</script>
