---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <!-- ─── NAV ─────────────────────────────────────────── -->
  <header class="fixed top-0 left-0 right-0 z-50 px-6 md:px-16 lg:px-24 xl:px-32 py-6 md:py-7 flex items-center justify-between" style="background: linear-gradient(to bottom, rgba(0,0,0,0.98) 0%, rgba(0,0,0,0.85) 80%, transparent 100%); backdrop-filter: blur(4px);">
    <a href="/" class="text-[#fdfcf8] uppercase select-none" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 22px; font-weight: 400; letter-spacing: 0.3em;">
      Faloe
    </a>
    <nav class="flex items-center gap-5 md:gap-10" style="font-family: 'Inter', system-ui, sans-serif;">
      <a href="#foundry"   class="text-[11px] md:text-[12px] uppercase font-light text-[#c8c5bc] hover:text-[#fdfcf8] transition-colors duration-300" style="letter-spacing: 0.06em;">Foundry</a>
      <a href="#field"     class="text-[11px] md:text-[12px] uppercase font-light text-[#c8c5bc] hover:text-[#fdfcf8] transition-colors duration-300" style="letter-spacing: 0.06em;">Field</a>
      <a href="#studio"    class="text-[11px] md:text-[12px] uppercase font-light text-[#c8c5bc] hover:text-[#fdfcf8] transition-colors duration-300" style="letter-spacing: 0.06em;">Studio</a>
    </nav>
  </header>

  <!-- ─── HERO ─────────────────────────────────────────── -->
  <section class="relative min-h-screen flex flex-col justify-center px-8 md:px-16 lg:px-24 xl:px-32">

    <div class="absolute top-32 left-8 md:left-16 lg:left-24 xl:left-32 right-8 md:right-16 h-px bg-[#fdfcf8] opacity-10"></div>

    <div class="max-w-5xl pt-24 pb-32">

      <p class="text-[12px] tracking-[0.3em] uppercase text-[#B8963E] mb-16 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        Est. 2026 &nbsp;&middot;&nbsp; New York
      </p>

      <h1
        class="font-light leading-[0.92] text-[#fdfcf8]"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(3rem, 8vw, 7.5rem); letter-spacing: -0.04em;"
      >
        Cinema is passed<br />
        <span style="font-style: italic; color: #B8963E;">down by hand.</span>
      </h1>

      <p class="mt-12 font-light text-[#fdfcf8]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.4rem, 2.5vw, 2rem); letter-spacing: -0.01em; opacity: 0.72;">
        Film workshops. Location expeditions. A production studio.
      </p>

      <div class="mt-6 flex items-center gap-6">
        <div class="w-8 h-px opacity-80" style="background: #B8963E;"></div>
        <p class="font-light text-[#c8c5bc] max-w-sm leading-relaxed" style="font-family: 'Inter', system-ui, sans-serif; font-size: 15px;">
          For anyone serious about the work. Built on craft. New York.
        </p>
      </div>

      <!-- Film metadata annotation — a maker's mark -->
      <p class="mt-10 text-[12px] font-light text-[#fdfcf8]" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.22em; opacity: 0.5;">
        [ 1.85:1 &nbsp;/&nbsp; 24fps &nbsp;/&nbsp; New York ]
      </p>

    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 opacity-30">
      <div class="w-px h-12 bg-[#fdfcf8]" style="animation: pulse 2s ease-in-out infinite;"></div>
    </div>

  </section>

  <!-- ─── PILLARS OVERVIEW ──────────────────────────────── -->
  <section id="pillars" class="px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-40 border-t border-[#fdfcf8] border-opacity-10">

    <p class="text-[12px] tracking-[0.3em] uppercase text-[#B8963E] mb-20 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
      The Work
    </p>

    <div class="grid md:grid-cols-3 gap-16 md:gap-0">

      <!-- Pillar 1 -->
      <div class="md:pr-12 lg:pr-16">
        <p class="text-[12px] tracking-[0.35em] uppercase text-[#B8963E] mb-6 font-light opacity-60" style="font-family: 'Inter', system-ui, sans-serif;">
          I &nbsp;/&nbsp; The Labs
        </p>
        <h2 class="font-light text-[#fdfcf8] mb-6 leading-tight" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: 0.06em;">
          Faloe<br />Foundry
        </h2>
        <div class="w-5 h-px bg-[#fdfcf8] opacity-30 mb-6"></div>
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          Intensives and targeted training programs for working filmmakers.
          Project-based from day one. Led by working industry professionals, Jonathan Whittaker among them. Based in New York and online.
        </p>
      </div>

      <!-- Pillar 2 -->
      <div class="md:px-12 lg:px-16 md:border-x border-[#fdfcf8] border-opacity-10">
        <p class="text-[12px] tracking-[0.35em] uppercase text-[#B8963E] mb-6 font-light opacity-60" style="font-family: 'Inter', system-ui, sans-serif;">
          II &nbsp;/&nbsp; The Expeditions
        </p>
        <h2 class="font-light text-[#fdfcf8] mb-6 leading-tight" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: 0.06em;">
          Faloe<br />Field
        </h2>
        <div class="w-5 h-px bg-[#fdfcf8] opacity-30 mb-6"></div>
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          A three-phase cohort model: virtual pre-production, an intensive destination shoot,
          and supervised post-production. You arrive with a story. You leave with a micro-documentary
          or a series of finished scenes. The expedition is the work.
        </p>
      </div>

      <!-- Pillar 3 -->
      <div class="md:pl-12 lg:pl-16">
        <p class="text-[12px] tracking-[0.35em] uppercase text-[#B8963E] mb-6 font-light opacity-60" style="font-family: 'Inter', system-ui, sans-serif;">
          III &nbsp;/&nbsp; The Studio
        </p>
        <h2 class="font-light text-[#fdfcf8] mb-6 leading-tight" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: 0.06em;">
          Faloe<br />Studios
        </h2>
        <div class="w-5 h-px bg-[#fdfcf8] opacity-30 mb-6"></div>
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          A dedicated production space in formation. Designed for artist residencies,
          feature co-productions, and commercial and branded work. Currently accepting
          inquiries from prospective collaborators and partners.
        </p>
      </div>

    </div>

  </section>

  <!-- ─── FOUNDRY ───────────────────────────────────────── -->
  <section id="foundry" class="relative px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-48 border-t border-[#fdfcf8] border-opacity-10 overflow-hidden">

    <div class="absolute inset-0 flex items-end justify-end pointer-events-none select-none pr-8 md:pr-16 pb-12 overflow-hidden" aria-hidden="true">
      <span class="font-light text-[#fdfcf8]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(6rem, 18vw, 18rem); letter-spacing: -0.04em; opacity: 0.03; line-height: 1;">01</span>
    </div>

    <div class="relative max-w-2xl">

      <p class="text-[12px] tracking-[0.3em] uppercase text-[#B8963E] mb-16 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        Foundry &nbsp;&middot;&nbsp; The Labs &nbsp;&middot;&nbsp; Summer 2026
      </p>

      <h2
        class="font-light text-[#fdfcf8] leading-[0.95] mb-12"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.03em;"
      >
        The Lab<br />Intensives
      </h2>

      <!-- Pull quote -->
      <p class="font-light text-[#fdfcf8] leading-[1.15] mb-12" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.35rem, 2.5vw, 1.85rem); letter-spacing: -0.02em; font-style: italic; opacity: 0.75;">
        If you want to be a filmmaker, you must make films.
      </p>

    </div><!-- /max-w-2xl -->

    <!-- Image — full section width, widescreen, B&W -->
    <div class="relative my-16 overflow-hidden" style="aspect-ratio: 16/9;">
      <img
        src="/genoa-set-cafe.jpeg"
        alt="On set in Genoa, February 2026."
        class="w-full h-full object-cover"
        style="filter: grayscale(100%) brightness(0.75) contrast(1.08); object-position: center center;"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, transparent 50%, #000000 100%);"></div>
    </div>

    <div class="relative max-w-2xl">

      <div class="space-y-10 mb-16">

        <div class="space-y-4">
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Foundry workshops are intensives built around a single discipline:
            directing, cinematography, producing, editing, sound design.
          </p>
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Each program is project-based from the first session.
          </p>
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            You bring the raw story.
            We help you mine it, shape it, and hold it to a standard worth putting in a portfolio.
          </p>
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Every participant leaves with a finished cut, substantive feedback,
            and a room full of people who were in it with them.
          </p>
        </div>

        <div class="space-y-4">
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            We don&rsquo;t teach passion.
            We harness yours.
          </p>
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            The process is iterative by design:
            make something, troubleshoot it, try again.
          </p>
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            That cycle, repeated under professional guidance,
            is what builds the portfolio and the instincts that lead to real work in the field.
          </p>
        </div>

        <div class="space-y-4">
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Programs are led by working industry professionals. Each brings their current practice into the room. Not theory. Not history.
          </p>
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Some intensives are led by Jonathan Whittaker. Others are designed and led by practitioners who have built something worth teaching.
          </p>
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            This is the master-apprentice model.
            Sessions run in New York and online,
            with formats designed around the work, not the other way around.
          </p>
        </div>

      </div>

      <!-- Cohort note -->
      <div class="border-l-2 border-[#fdfcf8] border-opacity-10 pl-6 mb-16">
        <p class="font-light text-[#c8c5bc] leading-[1.85] italic" style="font-family: 'Inter', system-ui, sans-serif; font-size: 15px; letter-spacing: 0.01em;">
          Small cohorts are by design. Every participant gets real attention.
        </p>
      </div>

      <!-- Workshop page link -->
      <div class="mb-16">
        <p class="text-[11px] tracking-[0.3em] uppercase font-light mb-3" style="font-family: 'Inter', system-ui, sans-serif; color: #B8963E;">Beyond Do It Again</p>
        <a
          href="/workshops/beyond-do-it-again"
          class="cta-primary inline-block text-[13px] font-light uppercase"
          style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.12em; padding: 18px 48px; background: transparent; color: #B8963E; text-decoration: none;"
        >
          [&nbsp;Now Enrolling&nbsp;]
        </a>
      </div>

      <!-- Custom Workshops -->
      <div class="border-t border-[#fdfcf8] border-opacity-10 pt-12">

        <p class="text-[12px] tracking-[0.35em] uppercase text-[#B8963E] mb-8 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
          Also Under the Foundry Umbrella
        </p>

        <h3 class="font-light text-[#fdfcf8] leading-[0.95] mb-8" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.75rem, 3.5vw, 2.75rem); letter-spacing: -0.02em;">
          Custom<br />Workshops
        </h3>

        <p class="font-light text-[#c8c5bc] leading-[1.85] mb-8" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          Custom workshops and training modules for corporations, NGOs, non-profits, and institutions.
          Built around your goals, in direct consultation with our team.
        </p>

        <a
          href="/book"
          class="inline-block text-[#fdfcf8] text-[12px] font-light hover:opacity-60 transition-opacity duration-300"
          style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.12em; text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px;"
        >
          INQUIRE ABOUT CUSTOM TRAINING
        </a>


      </div>

    </div>

  </section>

  <!-- ─── FIELD ─────────────────────────────────────────── -->
  <section id="field" class="relative px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-48 border-t border-[#fdfcf8] border-opacity-10 overflow-hidden">

    <div class="absolute inset-0 flex items-end justify-end pointer-events-none select-none pr-8 md:pr-16 pb-12 overflow-hidden" aria-hidden="true">
      <span class="font-light text-[#fdfcf8]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(6rem, 18vw, 18rem); letter-spacing: -0.04em; opacity: 0.03; line-height: 1;">02</span>
    </div>

    <div class="relative max-w-2xl">

      <p class="text-[12px] tracking-[0.3em] uppercase text-[#B8963E] mb-16 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        Field &nbsp;&middot;&nbsp; Expedition 001
      </p>

      <h2
        class="font-light text-[#fdfcf8] leading-[0.95] mb-12"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.03em;"
      >
        Expedition 001:<br /><span style="font-style: italic;">The Interior</span>
      </h2>

    </div>

    <!-- Image — full-bleed, full color -->
    <div class="relative -mx-8 md:-mx-16 lg:-mx-24 xl:-mx-32 mb-16 overflow-hidden h-[360px] md:h-[480px] lg:h-[560px]">
      <img
        src="/images/expedition/peru/peru-golden-hour-road.jpeg"
        alt="Golden hour on a road through the expedition landscape, Peru"
        class="w-full h-full object-cover"
        style="object-position: center 70%;"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, transparent 50%, #000000 100%);"></div>
    </div>

    <div class="relative max-w-2xl">

      <!-- Three-pronged value -->
      <div class="grid grid-cols-3 gap-6 mb-16 border-t border-[#fdfcf8] border-opacity-10 pt-10">
        <div>
          <p class="text-[12px] tracking-[0.2em] uppercase text-[#B8963E] opacity-60 mb-3 font-light" style="font-family: 'Inter', system-ui, sans-serif;">I</p>
          <p class="font-light text-[#fdfcf8] leading-[1.5]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1rem, 1.5vw, 1.2rem); letter-spacing: -0.01em;">Training that produces footage worth showing</p>
        </div>
        <div>
          <p class="text-[12px] tracking-[0.2em] uppercase text-[#B8963E] opacity-60 mb-3 font-light" style="font-family: 'Inter', system-ui, sans-serif;">II</p>
          <p class="font-light text-[#fdfcf8] leading-[1.5]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1rem, 1.5vw, 1.2rem); letter-spacing: -0.01em;">A portfolio of original footage, yours to own</p>
        </div>
        <div>
          <p class="text-[12px] tracking-[0.2em] uppercase text-[#B8963E] opacity-60 mb-3 font-light" style="font-family: 'Inter', system-ui, sans-serif;">III</p>
          <p class="font-light text-[#fdfcf8] leading-[1.5]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1rem, 1.5vw, 1.2rem); letter-spacing: -0.01em;">Deep cultural immersion in a distinct landscape</p>
        </div>
      </div>

      <p class="font-light text-[#c8c5bc] leading-[1.85] mb-16" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        Each expedition is built around a destination chosen for its terrain, its people,
        and its visual traditions. Not a field trip. Not a technical exercise.
        Twelve participants. One destination. You arrive with a story. You leave with a micro-documentary or a series of finished scenes.
      </p>

      <!-- Three phases -->
      <div class="space-y-0 mb-16">

        <div class="border-t border-[#fdfcf8] border-opacity-10 py-8 grid grid-cols-[3rem_1fr] gap-6 items-start">
          <p class="text-[12px] tracking-[0.12em] uppercase text-[#B8963E] opacity-60 pt-1 font-light" style="font-family: 'Inter', system-ui, sans-serif;">[&nbsp;01&nbsp;]</p>
          <div>
            <p class="text-[12px] tracking-[0.2em] uppercase text-[#B8963E] mb-3 font-light" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.1em;">Virtual Lead-Up &nbsp;&middot;&nbsp; 2 Weeks</p>
            <div class="space-y-3">
              <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
                Story development, shot-listing, terrain research, and logistics.
                All online, with the full cohort.
              </p>
              <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
                You arrive in the field with a clear vision and a production plan.
                No wasted days on the ground.
              </p>
            </div>
          </div>
        </div>

        <div class="border-t border-[#fdfcf8] border-opacity-10 py-8 grid grid-cols-[3rem_1fr] gap-6 items-start">
          <p class="text-[12px] tracking-[0.12em] uppercase text-[#B8963E] opacity-60 pt-1 font-light" style="font-family: 'Inter', system-ui, sans-serif;">[&nbsp;02&nbsp;]</p>
          <div>
            <p class="text-[12px] tracking-[0.2em] uppercase text-[#B8963E] mb-3 font-light" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.1em;">The Field &nbsp;&middot;&nbsp; 10 Days</p>
            <div class="space-y-3">
              <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
                On-location production. The landscape, the light, and the people
                encountered all become active ingredients in the work.
              </p>
              <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
                The pressure, the decisions, the collaboration: all real.
                Make mistakes. Troubleshoot. Shoot again.
              </p>
              <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
                You will be uncertain at some point. Everyone is.
                The footage you produce is yours.
              </p>
            </div>
          </div>
        </div>

        <div class="border-t border-b border-[#fdfcf8] border-opacity-10 py-8 grid grid-cols-[3rem_1fr] gap-6 items-start">
          <p class="text-[12px] tracking-[0.12em] uppercase text-[#B8963E] opacity-60 pt-1 font-light" style="font-family: 'Inter', system-ui, sans-serif;">[&nbsp;03&nbsp;]</p>
          <div>
            <p class="text-[12px] tracking-[0.2em] uppercase text-[#B8963E] mb-3 font-light" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.1em;">Post-Production &nbsp;&middot;&nbsp; Supervised</p>
            <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
              Supervised remote editing, color, and sound with structured feedback sessions.
              An optional in-person residency in New York is available for participants
              who want to finish the cut in the room.
            </p>
          </div>
        </div>

      </div>

      <p class="font-light text-[#c8c5bc] italic leading-[1.8] mb-12" style="font-family: 'Inter', system-ui, sans-serif; font-size: 14px; letter-spacing: 0.02em;">
        Location and dates are currently in formation. This expedition is limited to twelve participants.
      </p>

      <!-- Expedition 001 CTA -->
      <a
        href="/field/expedition-001"
        class="cta-primary inline-block text-[13px] font-light uppercase mb-8"
        style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.12em; padding: 18px 48px; background: transparent; color: #B8963E; text-decoration: none;"
      >
        [&nbsp;Expedition 001 &middot; Now Enrolling&nbsp;]
      </a>

      <!-- CTA after Expedition -->
      <div>
        <a
          href="/book"
          class="inline-block text-[#fdfcf8] text-[10px] font-light hover:opacity-60 transition-opacity duration-300"
          style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.12em; text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px;"
        >
          SCHEDULE A CONSULTATION
        </a>
      </div>

    </div>

  </section>

  <!-- ─── STUDIO ────────────────────────────────────────── -->
  <section id="studio" class="relative px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-48 border-t border-[#fdfcf8] border-opacity-10 overflow-hidden">

    <div class="absolute inset-0 flex items-end justify-end pointer-events-none select-none pr-8 md:pr-16 pb-12 overflow-hidden" aria-hidden="true">
      <span class="font-light text-[#fdfcf8]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(6rem, 18vw, 18rem); letter-spacing: -0.04em; opacity: 0.03; line-height: 1;">03</span>
    </div>

