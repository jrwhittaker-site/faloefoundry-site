---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <!-- ─── NAV ─────────────────────────────────────────── -->
  <header class="fixed top-0 left-0 right-0 z-50 px-6 md:px-16 lg:px-24 xl:px-32 py-6 md:py-7 flex items-center justify-between" style="background: linear-gradient(to bottom, rgba(0,0,0,0.98) 0%, rgba(0,0,0,0.85) 80%, transparent 100%); backdrop-filter: blur(4px);">
    <a href="/" class="text-[#fdfcf8] uppercase select-none" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 18px; font-weight: 400; letter-spacing: 0.3em;">
      Faloe
    </a>
    <nav class="flex items-center gap-5 md:gap-10" style="font-family: 'Inter', system-ui, sans-serif;">
      <a href="#foundry"   class="text-[9px] md:text-[10px] uppercase font-light text-[#c8c5bc] hover:text-[#fdfcf8] transition-colors duration-300" style="letter-spacing: 0.06em;">Foundry</a>
      <a href="#field"     class="text-[9px] md:text-[10px] uppercase font-light text-[#c8c5bc] hover:text-[#fdfcf8] transition-colors duration-300" style="letter-spacing: 0.06em;">Field</a>
      <a href="#studio"    class="text-[9px] md:text-[10px] uppercase font-light text-[#c8c5bc] hover:text-[#fdfcf8] transition-colors duration-300" style="letter-spacing: 0.06em;">Studio</a>
      <a href="#manifesto" class="text-[9px] md:text-[10px] uppercase font-light text-[#c8c5bc] hover:text-[#fdfcf8] transition-colors duration-300" style="letter-spacing: 0.06em;">Manifesto</a>
    </nav>
  </header>

  <!-- ─── HERO ─────────────────────────────────────────── -->
  <section class="relative min-h-screen flex flex-col justify-center px-8 md:px-16 lg:px-24 xl:px-32">

    <div class="absolute top-32 left-8 md:left-16 lg:left-24 xl:left-32 right-8 md:right-16 h-px bg-[#fdfcf8] opacity-10"></div>

    <div class="max-w-5xl pt-24 pb-32">

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-16 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        Est. 2026 &nbsp;&middot;&nbsp; New York
      </p>

      <h1
        class="font-light leading-[0.92] text-[#fdfcf8]"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(3rem, 8vw, 7.5rem); letter-spacing: -0.04em;"
      >
        Cinema is a<br />
        <span style="font-style: italic;">Human Tradition.</span><br />
        Let&rsquo;s return to it.
      </h1>

      <div class="mt-16 flex items-center gap-6">
        <div class="w-8 h-px bg-[#fdfcf8] opacity-40"></div>
        <p class="font-light text-[#c8c5bc] max-w-sm leading-relaxed" style="font-family: 'Inter', system-ui, sans-serif; font-size: 15px;">
          Film workshops, location expeditions, and a production studio for working storytellers.
        </p>
      </div>

    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 opacity-30">
      <div class="w-px h-12 bg-[#fdfcf8]" style="animation: pulse 2s ease-in-out infinite;"></div>
    </div>

  </section>

  <!-- ─── PILLARS OVERVIEW ──────────────────────────────── -->
  <section id="pillars" class="px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-40 border-t border-[#fdfcf8] border-opacity-10">

    <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-20 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
      The Work
    </p>

    <div class="grid md:grid-cols-3 gap-16 md:gap-0">

      <!-- Pillar 1 -->
      <div class="md:pr-12 lg:pr-16">
        <p class="text-[9px] tracking-[0.35em] uppercase text-[#c8c5bc] mb-6 font-light opacity-60" style="font-family: 'Inter', system-ui, sans-serif;">
          I &nbsp;/&nbsp; The Labs
        </p>
        <h2 class="font-light text-[#fdfcf8] mb-6 leading-tight" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: 0.06em;">
          Faloe<br />Foundry
        </h2>
        <div class="w-5 h-px bg-[#fdfcf8] opacity-30 mb-6"></div>
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          High-impact intensives and bespoke training programs for working filmmakers.
          Project-based from day one. Led by the founder with active industry professionals
          as guest mentors. Based in New York and online.
        </p>
      </div>

      <!-- Pillar 2 -->
      <div class="md:px-12 lg:px-16 md:border-x border-[#fdfcf8] border-opacity-10">
        <p class="text-[9px] tracking-[0.35em] uppercase text-[#c8c5bc] mb-6 font-light opacity-60" style="font-family: 'Inter', system-ui, sans-serif;">
          II &nbsp;/&nbsp; The Expeditions
        </p>
        <h2 class="font-light text-[#fdfcf8] mb-6 leading-tight" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: 0.06em;">
          Faloe<br />Field
        </h2>
        <div class="w-5 h-px bg-[#fdfcf8] opacity-30 mb-6"></div>
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          A three-phase cohort model: virtual pre-production, an intensive destination shoot,
          and supervised post-production. You arrive with a story. You leave with a film.
          The expedition is the curriculum.
        </p>
      </div>

      <!-- Pillar 3 -->
      <div class="md:pl-12 lg:pl-16">
        <p class="text-[9px] tracking-[0.35em] uppercase text-[#c8c5bc] mb-6 font-light opacity-60" style="font-family: 'Inter', system-ui, sans-serif;">
          III &nbsp;/&nbsp; The Studio
        </p>
        <h2 class="font-light text-[#fdfcf8] mb-6 leading-tight" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: 0.06em;">
          Faloe<br />Studios
        </h2>
        <div class="w-5 h-px bg-[#fdfcf8] opacity-30 mb-6"></div>
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          A dedicated production space in formation. Designed for artist residencies,
          feature co-productions, and bespoke commercial work. Currently accepting
          inquiries from prospective collaborators and partners.
        </p>
      </div>

    </div>

  </section>

  <!-- ─── TECHNOLOGY PHILOSOPHY ─────────────────────────── -->
  <section id="philosophy" class="relative px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-48 border-t border-[#fdfcf8] border-opacity-10 overflow-hidden">

    <div class="absolute inset-0 flex items-center justify-end pointer-events-none select-none pr-8 md:pr-16 overflow-hidden" aria-hidden="true">
      <span class="font-light text-[#fdfcf8]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(8rem, 20vw, 22rem); letter-spacing: -0.04em; opacity: 0.025; line-height: 1;">F</span>
    </div>

    <div class="relative max-w-3xl">

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-16 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        The Human Tradition
      </p>

      <h2
        class="font-light text-[#fdfcf8] leading-[0.95] mb-12"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.5rem, 5.5vw, 4.5rem); letter-spacing: -0.03em;"
      >
        Technology in service<br />of the artist.<br /><span style="font-style: italic;">Always.</span>
      </h2>

      <div class="space-y-6 max-w-2xl">
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          Filmmakers have embraced new technology for over a century: from orthochromatic emulsion
          to digital capture, from optical printers to non-linear editing. Every tool extended the
          same gesture. A human being deciding what to look at, and why. We are no different.
          We fully embrace the evolution of cinema technology.
        </p>
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          We draw one clear line. In our workshops and programs, technology supports the artist.
          It does not replace them. There is no AI on the screen or in the script.
          The frame is authored by a human being with something to say.
        </p>
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          This is not a rejection of progress. It is a commitment to a tradition: the filmmaker
          as author, the cam&eacute;ra-stylo, the deliberate eye. We are dedicated to the human
          tradition of storytelling. In our rooms, that tradition is not theory. It is practice.
        </p>
      </div>

    </div>

  </section>

  <!-- ─── FOUNDRY ───────────────────────────────────────── -->
  <section id="foundry" class="relative px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-48 border-t border-[#fdfcf8] border-opacity-10 overflow-hidden">

    <div class="absolute inset-0 flex items-end justify-end pointer-events-none select-none pr-8 md:pr-16 pb-12 overflow-hidden" aria-hidden="true">
      <span class="font-light text-[#fdfcf8]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(6rem, 18vw, 18rem); letter-spacing: -0.04em; opacity: 0.03; line-height: 1;">01</span>
    </div>

    <div class="relative max-w-2xl">

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-16 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        Foundry &nbsp;&middot;&nbsp; The Labs &nbsp;&middot;&nbsp; Summer 2026
      </p>

      <h2
        class="font-light text-[#fdfcf8] leading-[0.95] mb-12"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.03em;"
      >
        The Lab<br />Intensives
      </h2>

      <!-- Pull quote: learn by doing -->
      <p class="font-light text-[#fdfcf8] leading-[1.15] mb-12" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.35rem, 2.5vw, 1.85rem); letter-spacing: -0.02em; font-style: italic; opacity: 0.75;">
        If you want to be a filmmaker, you must make films.
      </p>

      <div class="space-y-6 mb-16">
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          Foundry workshops are high-impact intensives built around a single discipline: directing,
          cinematography, editing, sound design. Each program is project-based from the first session.
          You bring the raw story. We help you mine it, shape it, and hold it to a professional
          cinematic standard. Every participant leaves with finished work and substantive feedback,
          not just notes.
        </p>
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          We don&rsquo;t teach passion. We harness yours. The process is iterative by design:
          make something, troubleshoot it, try again. That cycle, repeated under professional
          guidance, is what builds the portfolio and the instincts that lead to real work in the field.
        </p>
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          Programs are led by the founder, with working industry professionals brought in as guest
          mentors for specific intensives. Each guest brings active, current practice into the room.
          Not theory. Not history. Practice. This is the master-apprentice model. Sessions run
          in New York and online, with formats designed around the work, not the other way around.
        </p>
      </div>

      <!-- Neurodiversity note -->
      <div class="border-l-2 border-[#fdfcf8] border-opacity-10 pl-6 mb-16">
        <p class="font-light text-[#c8c5bc] leading-[1.85] italic" style="font-family: 'Inter', system-ui, sans-serif; font-size: 15px; letter-spacing: 0.01em;">
          Built for diverse minds. Our curriculum is developed alongside neurodiversity-trained
          educators to ensure our master-apprentice model is adaptive, inclusive, and tailored
          to the unique processing styles of all storytellers.
        </p>
      </div>

      <!-- Bespoke Workshops -->
      <div class="border-t border-[#fdfcf8] border-opacity-10 pt-12">

        <p class="text-[9px] tracking-[0.35em] uppercase text-[#c8c5bc] mb-8 font-light opacity-60" style="font-family: 'Inter', system-ui, sans-serif;">
          Also Under the Foundry Umbrella
        </p>

        <h3 class="font-light text-[#fdfcf8] leading-[0.95] mb-8" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.75rem, 3.5vw, 2.75rem); letter-spacing: -0.02em;">
          Bespoke<br />Workshops
        </h3>

        <p class="font-light text-[#c8c5bc] leading-[1.85] mb-8" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          Targeted training for individuals, production teams, corporations, NGOs, and non-profits
          seeking goal-specific cinematic output and professional mentorship. Each engagement is
          designed from the ground up in direct consultation with the founder. No off-the-shelf
          curriculum. No generic frameworks. Every program is purpose-built for the people in the room.
        </p>

        <a
          href="https://calendly.com/placeholder"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-[#fdfcf8] text-[10px] font-light hover:opacity-60 transition-opacity duration-300"
          style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.12em; text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px;"
        >
          INQUIRE ABOUT BESPOKE TRAINING
        </a>

      </div>

    </div>

  </section>

  <!-- ─── FIELD ─────────────────────────────────────────── -->
  <section id="field" class="relative px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-48 border-t border-[#fdfcf8] border-opacity-10 overflow-hidden">

    <div class="absolute inset-0 flex items-end justify-end pointer-events-none select-none pr-8 md:pr-16 pb-12 overflow-hidden" aria-hidden="true">
      <span class="font-light text-[#fdfcf8]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(6rem, 18vw, 18rem); letter-spacing: -0.04em; opacity: 0.03; line-height: 1;">02</span>
    </div>

    <div class="relative max-w-2xl">

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-16 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        Field &nbsp;&middot;&nbsp; Expedition 001
      </p>

      <h2
        class="font-light text-[#fdfcf8] leading-[0.95] mb-12"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.03em;"
      >
        Expedition 001:<br /><span style="font-style: italic;">The Interior</span>
      </h2>

      <!-- Three-pronged value -->
      <div class="grid grid-cols-3 gap-6 mb-16 border-t border-[#fdfcf8] border-opacity-10 pt-10">
        <div>
          <p class="text-[9px] tracking-[0.2em] uppercase text-[#c8c5bc] opacity-50 mb-3 font-light" style="font-family: 'Inter', system-ui, sans-serif;">I</p>
          <p class="font-light text-[#fdfcf8] leading-[1.5]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1rem, 1.5vw, 1.2rem); letter-spacing: -0.01em;">Elite cinematic training at professional standards</p>
        </div>
        <div>
          <p class="text-[9px] tracking-[0.2em] uppercase text-[#c8c5bc] opacity-50 mb-3 font-light" style="font-family: 'Inter', system-ui, sans-serif;">II</p>
          <p class="font-light text-[#fdfcf8] leading-[1.5]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1rem, 1.5vw, 1.2rem); letter-spacing: -0.01em;">A tangible portfolio of high-end original footage</p>
        </div>
        <div>
          <p class="text-[9px] tracking-[0.2em] uppercase text-[#c8c5bc] opacity-50 mb-3 font-light" style="font-family: 'Inter', system-ui, sans-serif;">III</p>
          <p class="font-light text-[#fdfcf8] leading-[1.5]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1rem, 1.5vw, 1.2rem); letter-spacing: -0.01em;">Deep cultural immersion in a distinct landscape</p>
        </div>
      </div>

      <p class="font-light text-[#c8c5bc] leading-[1.85] mb-16" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        Each expedition is built around a destination chosen for the richness of its terrain,
        its people, and its visual traditions. Not a field trip. Not a technical exercise.
        Cinematic exploration in a distinct landscape, where the location itself dictates the
        visual language of the project. Twelve participants. One destination. You arrive with
        a story. You leave with a film.
      </p>

      <!-- Three phases -->
      <div class="space-y-0 mb-16">

        <div class="border-t border-[#fdfcf8] border-opacity-10 py-8 grid grid-cols-[3rem_1fr] gap-6 items-start">
          <p class="text-[9px] tracking-[0.2em] uppercase text-[#c8c5bc] opacity-50 pt-1 font-light" style="font-family: 'Inter', system-ui, sans-serif;">01</p>
          <div>
            <p class="text-[10px] tracking-[0.2em] uppercase text-[#c8c5bc] mb-3 font-light" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.1em;">Virtual Lead-Up</p>
            <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
              Two weeks of focused online sessions covering story development, terrain scouting,
              logistics, and equipment planning. Participants arrive in the field with a clear
              vision, a shot list, and a production plan. No wasted days on the ground.
            </p>
          </div>
        </div>

        <div class="border-t border-[#fdfcf8] border-opacity-10 py-8 grid grid-cols-[3rem_1fr] gap-6 items-start">
          <p class="text-[9px] tracking-[0.2em] uppercase text-[#c8c5bc] opacity-50 pt-1 font-light" style="font-family: 'Inter', system-ui, sans-serif;">02</p>
          <div>
            <p class="text-[10px] tracking-[0.2em] uppercase text-[#c8c5bc] mb-3 font-light" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.1em;">The Field</p>
            <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
              All hands on deck. The cohort convenes at the destination for a five to ten day
              high-intensity shoot. Deep terrain immersion: the landscape, the light, the people
              encountered, and the visual culture of the place all become active ingredients in
              the work. Cultural immersion through the lens, engaging honestly with local
              geography and visual traditions. The pressure, the decisions, the collaboration:
              all real. Make mistakes. Troubleshoot. Shoot again. The footage you produce is yours.
            </p>
          </div>
        </div>

        <div class="border-t border-b border-[#fdfcf8] border-opacity-10 py-8 grid grid-cols-[3rem_1fr] gap-6 items-start">
          <p class="text-[9px] tracking-[0.2em] uppercase text-[#c8c5bc] opacity-50 pt-1 font-light" style="font-family: 'Inter', system-ui, sans-serif;">03</p>
          <div>
            <p class="text-[10px] tracking-[0.2em] uppercase text-[#c8c5bc] mb-3 font-light" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.1em;">The Edit</p>
            <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
              Supervised remote post-production with structured feedback sessions. An optional
              in-person residency in New York City is available for participants who want to
              complete their edit in the room alongside the founder.
            </p>
          </div>
        </div>

      </div>

      <p class="font-light text-[#c8c5bc] italic leading-[1.8]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 14px; letter-spacing: 0.02em;">
        Location and dates are currently in formation. This expedition is limited to twelve participants.
      </p>

    </div>

  </section>

  <!-- ─── STUDIO ────────────────────────────────────────── -->
  <section id="studio" class="relative px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-48 border-t border-[#fdfcf8] border-opacity-10 overflow-hidden">

    <div class="absolute inset-0 flex items-end justify-end pointer-events-none select-none pr-8 md:pr-16 pb-12 overflow-hidden" aria-hidden="true">
      <span class="font-light text-[#fdfcf8]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(6rem, 18vw, 18rem); letter-spacing: -0.04em; opacity: 0.03; line-height: 1;">03</span>
    </div>

    <div class="relative max-w-2xl">

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-16 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        The Studio &nbsp;&middot;&nbsp; In Formation
      </p>

      <h2
        class="font-light text-[#fdfcf8] leading-[0.95] mb-12"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.03em;"
      >
        Faloe<br /><span style="font-style: italic;">Studios</span>
      </h2>

      <div class="space-y-6 mb-12">
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          A dedicated production space designed for the next phase of Faloe's work.
          Artist residencies for filmmakers who need time, space, and serious collaborators.
          Feature co-productions developed with precision and full creative control.
          Bespoke commercial and branded content for organizations with ambitious visual standards.
        </p>
        <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          Faloe Studios is the five-year horizon of this work. The storytellers we train
          in the Foundry and the field today are the collaborators who will inhabit it.
        </p>
      </div>

      <div class="border-t border-[#fdfcf8] border-opacity-10 pt-8">
        <p class="font-light text-[#c8c5bc] italic leading-[1.8]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 14px; letter-spacing: 0.02em;">
          Inquiries from prospective collaborators, co-production partners, and brands are welcome.
        </p>
      </div>

    </div>

  </section>

  <!-- ─── FOUNDER'S NOTE ───────────────────────────────── -->
  <section id="founder" class="px-8 md:px-16 lg:px-24 xl:px-32 py-32 md:py-40 border-t border-[#fdfcf8] border-opacity-10">

    <div class="max-w-3xl">

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] mb-16 font-light" style="font-family: 'Inter', system-ui, sans-serif;">
        The Founder
      </p>

      <h2
        class="font-light text-[#fdfcf8] leading-[0.95] mb-12"
