---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Expedition 001 · Faloe Field · Western Ghats 2027"
  description="A ten day film expedition about coffee, shot on the estates of Chikmagalur, Karnataka, led by Amoghavarsha JS and Jonathan Whittaker. Twelve participants, October 2027."
  image="/og/expedition-001.jpg"
  imageAlt="A forest ridge under monsoon clouds in the Western Ghats, Karnataka."
>

  <!-- ─── NAV ─────────────────────────────────────────── -->
  <header class="fixed top-0 left-0 right-0 z-50 px-6 md:px-16 lg:px-24 xl:px-32 py-6 md:py-7 flex items-center justify-between" style="background: linear-gradient(to bottom, rgba(0,0,0,0.98) 0%, rgba(0,0,0,0.85) 80%, transparent 100%); backdrop-filter: blur(4px);">
    <a href="/" class="text-[#fdfcf8] uppercase select-none" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 22px; font-weight: 400; letter-spacing: 0.3em;">
      Faloe
    </a>
    <a
      href="/"
      class="text-[9px] md:text-[10px] uppercase font-light text-[#c8c5bc] hover:text-[#fdfcf8] transition-colors duration-300"
      style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.06em;"
    >
      ← Back
    </a>
  </header>

  <!-- ─── HERO ──────────────────────────────────────────── -->
  <section class="relative w-full h-[60vh] md:h-[90vh] overflow-hidden">

    <img
      src="/images/expedition/karnataka/karnataka-landscape-monsoon.jpg"
      alt="Forest ridge under monsoon clouds, Western Ghats, Karnataka"
      class="absolute inset-0 w-full h-full object-cover object-center"
      width="1920" height="1150" fetchpriority="high" decoding="async"
    />

    <div class="absolute inset-0" style="background: rgba(0,0,0,0.45);"></div>

    <div class="relative h-full flex flex-col items-center justify-center text-center px-8" data-fade>

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] font-light mb-6" style="font-family: 'Inter', system-ui, sans-serif;">
        Faloe Field &nbsp;&middot;&nbsp; Expedition 001
      </p>

      <h1
        class="font-light text-[#fdfcf8] leading-[0.95]"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.75rem, 7vw, 6rem); letter-spacing: -0.03em;"
      >
        FALOE FIELD<br />EXPEDITION 001
      </h1>

      <p class="font-light text-[#c8c5bc] leading-[1.85] mt-6" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        Western Ghats &middot; Karnataka &middot; India<br />
        Ten days in October 2027
      </p>

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] opacity-50 mt-4" style="font-family: 'Inter', system-ui, sans-serif;">
        [ Exact dates confirmed upon enrollment ]
      </p>

    </div>

  </section>

  <div class="w-full h-px bg-[#fdfcf8] opacity-10"></div>

  <!-- ─── EXPEDITION OVERVIEW ───────────────────────────── -->
  <section data-fade class="px-8 md:px-16 lg:px-24 xl:px-32 py-24 md:py-32" style="background: #0a0a08;">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">

      <!-- Left: text -->
      <div>
        <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] font-light mb-8" style="font-family: 'Inter', system-ui, sans-serif;">
          The Expedition
        </p>

        <div class="space-y-6">
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            The story told in Chikmagalur goes like this. In the 1600s, a Sufi pilgrim named Baba Budan came home from Mecca through the Yemeni port of Mocha, where coffee was only allowed out roasted so that no one else could grow it. He hid seven raw beans, carried them back to the hills above Chikmagalur, and planted them. Those hills now carry his name, and coffee has grown there ever since.
          </p>

          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            The estates we&rsquo;ll film on are private land where the Western Ghats forest meets working farmland. Coffee here grows in the shade of forest trees, which helps explain why so much wildlife still lives among the crops. The people who work this land and the animals around them are both part of the story.
          </p>

          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Twelve filmmakers will make one film together about that history and this landscape, working with two leads who know the region well and a professional production crew, from the first idea through the final cut.
          </p>
        </div>
      </div>

      <!-- Right: image -->
      <div>
        <img src="/images/expedition/karnataka/karnataka-minivet-coffee.jpg" alt="Orange Minivet on coffee plant, Western Ghats" class="w-full rounded-[4px] object-cover" width="1400" height="843" loading="lazy" decoding="async">
        <p style="font-family: 'Inter', system-ui, sans-serif; font-size: 10px; letter-spacing: 0.2em;" class="text-[#c8c5bc] opacity-50 uppercase mt-3">© Amoghavarsha</p>
      </div>

    </div>

  </section>

  <div class="w-full h-px bg-[#fdfcf8] opacity-10"></div>

  <!-- ─── LEADS ─────────────────────────────────────────── -->
  <section data-fade class="px-8 md:px-16 lg:px-24 xl:px-32 py-24 md:py-32" style="background: #0a0a08;">

    <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] font-light mb-16" style="font-family: 'Inter', system-ui, sans-serif;">
      The Leads
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-20">

      <!-- Amoghavarsha -->
      <div>
        <img src="/images/expedition/headshots/amoghavarsha.jpeg" alt="Amoghavarsha JS" class="w-full max-w-[280px] aspect-[4/5] object-cover object-top rounded-[4px] mb-8" width="569" height="934" loading="lazy" decoding="async">

        <h3 class="font-light text-[#fdfcf8] leading-[0.95] mb-6" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.8rem, 3vw, 2.5rem); letter-spacing: -0.03em;">
          Amoghavarsha JS
        </h3>

        <div class="space-y-4">
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Wildlife filmmaker, conservationist, and photographer. Two decades in these forests.
          </p>
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Co-director of Wild Karnataka, India's first 4K blue-chip natural history film, narrated by Sir David Attenborough. Winner of two National Film Awards. Art director on Divine Tides, the double Grammy-winning album by Ricky Kej and Stewart Copeland. His film Kali contributed directly to the renaming of a tiger reserve. His climate work was presented at the United Nations by two heads of state. Canon India EOS Ambassador.
          </p>
        </div>

        <div class="space-y-1 mt-6">
          <p class="italic text-[#B8963E] font-light" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem;">He knows where the animals are and how to build a story in this landscape.</p>
        </div>
      </div>

      <!-- Jonathan Whittaker -->
      <div>
        <img src="/images/expedition/headshots/jonathan-whittaker.jpeg" alt="Jonathan Whittaker" class="w-full max-w-[280px] aspect-[4/5] object-cover object-top rounded-[4px] mb-8" width="800" height="800" loading="lazy" decoding="async">

        <h3 class="font-light text-[#fdfcf8] leading-[0.95] mb-6" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.8rem, 3vw, 2.5rem); letter-spacing: -0.03em;">
          Jonathan Whittaker
        </h3>

        <div class="space-y-4">
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Filmmaker, producer, and educator with twenty years of documentary and commercial work across five continents.
          </p>
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            He directed a Sports Illustrated 3D special, a partnership between Sony Pictures and TIME Inc., and his producing credits include feature films and work for DirecTV and Nissan. At the New York Film Academy, he was Chair of Film Arts, Short Term, running the school&rsquo;s short-term workshops. He has led field productions in Peru and elsewhere in the Americas, South Africa, and India. Two of his former students directed their countries&rsquo; official Oscar submissions: Bruno Mourral for Haiti and Akinola Davies Jr. for the United Kingdom.
          </p>
        </div>

        <div class="space-y-1 mt-6">
          <p class="italic text-[#B8963E] font-light" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem;">He runs the production and the teaching, and he has made films in terrain like this before.</p>
        </div>
      </div>

    </div>

    <p class="font-light text-[#fdfcf8] italic text-center mb-16" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.5rem, 2.5vw, 2rem); letter-spacing: -0.03em;">
      Amoghavarsha knows the territory, and Jonathan runs the production and the teaching.
    </p>

    <div class="max-w-[800px] mx-auto">
      <img src="/images/expedition/peru/peru-jonathan-teaching.jpeg" alt="Jonathan Whittaker teaching in the field" class="w-full rounded-[4px] object-cover" width="1600" height="1200" loading="lazy" decoding="async">
    </div>

  </section>

  <div class="w-full h-px bg-[#fdfcf8] opacity-10"></div>

  <!-- ─── THE THREE PHASES ──────────────────────────────── -->
  <section data-fade class="px-8 md:px-16 lg:px-24 xl:px-32 py-24 md:py-32 bg-black">

    <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] font-light mb-16" style="font-family: 'Inter', system-ui, sans-serif;">
      The Three Phases
    </p>

    <div class="space-y-16">

      <!-- Phase 01 -->
      <div>
        <p class="font-light text-[#B8963E] leading-[1] mb-4" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(3rem, 6vw, 5rem);">01</p>
        <p class="font-light text-[#fdfcf8] text-[10px] tracking-[0.3em] uppercase mb-4" style="font-family: 'Inter', system-ui, sans-serif;">Virtual Pre-Production &nbsp;&middot;&nbsp; Two Weeks</p>
        <p class="font-light text-[#c8c5bc] leading-[1.85] max-w-[620px]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          Two weeks online with both leads and the full group before anyone travels. You&rsquo;ll develop the story, build shot lists, and research the Baba Budan history, the ecology of shade-grown coffee, and the wildlife of the Western Ghats, so you arrive knowing what you&rsquo;re making.
        </p>
      </div>

      <!-- Phase 02 -->
      <div>
        <p class="font-light text-[#B8963E] leading-[1] mb-4" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(3rem, 6vw, 5rem);">02</p>
        <p class="font-light text-[#fdfcf8] text-[10px] tracking-[0.3em] uppercase mb-4" style="font-family: 'Inter', system-ui, sans-serif;">The Field &nbsp;&middot;&nbsp; Ten Days in October 2027</p>
        <p class="font-light text-[#c8c5bc] leading-[1.85] max-w-[620px]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          Of the ten days on the ground, seven or eight are spent filming on the coffee estates and in the landscape around them, and the rest go to orientation and travel. The light, the wildlife, the farmers, and the forest all shape what you shoot. You&rsquo;ll work alongside a professional crew that includes a director of photography and a sound recordist, but the creative decisions are yours, and so is the work of finding the story in what you capture.
        </p>
      </div>

      <!-- Phase 03 -->
      <div>
        <p class="font-light text-[#B8963E] leading-[1] mb-4" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(3rem, 6vw, 5rem);">03</p>
        <p class="font-light text-[#fdfcf8] text-[10px] tracking-[0.3em] uppercase mb-4" style="font-family: 'Inter', system-ui, sans-serif;">Post-Production &nbsp;&middot;&nbsp; Supervised</p>
        <p class="font-light text-[#c8c5bc] leading-[1.85] max-w-[620px]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          Editing, color, and sound happen remotely, with scheduled feedback sessions along the way. If you&rsquo;d rather finish the cut in person, we can set you up at a post-production house in New York, though housing isn&rsquo;t included.
        </p>
      </div>

    </div>

    <div class="mt-20 grid grid-cols-1 md:grid-cols-2 gap-4 max-w-[900px] mx-auto justify-center">
      <img src="/images/expedition/peru/peru-jonathan-filming.jpeg" alt="Jonathan Whittaker filming on location, Peru" class="rounded-[4px] object-cover w-full aspect-[4/3]" width="1200" height="1600" loading="lazy" decoding="async">
      <img src="/images/expedition/peru/peru-cohort-forest.jpeg" alt="Cohort in the forest, Peru" class="rounded-[4px] object-cover w-full aspect-[4/3]" width="1200" height="900" loading="lazy" decoding="async">
    </div>

  </section>

  <div class="w-full h-px bg-[#fdfcf8] opacity-10"></div>

  <!-- ─── WHAT YOU LEAVE WITH / DETAILS / CTA ───────────── -->
  <section data-fade class="px-8 md:px-16 lg:px-24 xl:px-32 py-24 md:py-32" style="background: #0a0a08;">

    <!-- Part one: What you leave with -->
    <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] font-light mb-8" style="font-family: 'Inter', system-ui, sans-serif;">
      What You Leave With
    </p>

    <div class="space-y-3 max-w-[620px]">
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        A finished film, made with the group.
      </p>
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        Footage you shot, to use in your reel and to promote your own work.
      </p>
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        The experience of having made something difficult in a difficult place.
      </p>
    </div>

    <p class="italic text-[#c8c5bc] opacity-60 mt-2" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1rem;">
      The finished film is distributed jointly by Faloe and Indiverse. Every participant is credited on the film and on related content, following industry guidelines.
    </p>

    <div class="mt-12 max-w-[700px]">
      <img src="/images/expedition/peru/peru-student-rocky-terrain.jpeg" alt="Student filming on rocky terrain, Peru" class="w-full rounded-[4px] object-cover aspect-[16/10]" width="1400" height="1867" loading="lazy" decoding="async">
    </div>

    <div class="w-full h-px bg-[#fdfcf8] opacity-10 my-20"></div>

    <!-- Part two: The details -->
    <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] font-light mb-8" style="font-family: 'Inter', system-ui, sans-serif;">
      The Details
    </p>

    <p class="font-light text-[#fdfcf8] leading-[0.95] mb-8" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.5rem, 5vw, 4rem); letter-spacing: -0.03em;">
      $14,500
    </p>

    <div class="space-y-4 max-w-[620px]">
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        Expedition 001 is limited to twelve participants. The fee covers accommodation in Chikmagalur, ground transport within India, location access, and the full pre-production and post-production program. International flights and travel to your departure airport are not included.
      </p>
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        We can guide you through the visa process, but getting your visa is up to you, so start early.
      </p>
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        What we ask of you is commitment to the work and the ability to be in the Western Ghats for ten days in October 2027. Exact dates are confirmed when you enroll.
      </p>
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        Enrollment is open, and there&rsquo;s no application form. We fill the group through individual conversations, so the first step is booking a consultation.
      </p>
    </div>

    <div class="w-full h-px bg-[#fdfcf8] opacity-10 my-20"></div>

    <!-- Part three: CTA -->
    <a
      href="https://faloefoundry.com/book"
      class="cta-primary inline-block text-[13px] font-light uppercase"
      style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.12em; padding: 18px 48px; background: transparent; color: #B8963E; text-decoration: none;"
    >
      Schedule a Consultation
    </a>

  </section>

  <!-- ─── FOOTER ────────────────────────────────────────── -->
  <footer class="px-8 md:px-16 lg:px-24 xl:px-32 py-10 border-t border-[#fdfcf8] border-opacity-10">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <span class="text-[#fdfcf8] opacity-30" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 15px; letter-spacing: 0.2em;">
        Faloe
      </span>
      <div class="flex gap-8 text-[10px] uppercase font-light text-[#c8c5bc] opacity-30" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.2em;">
        <span>New York</span>
        <span>&copy; 2026</span>
      </div>
    </div>
  </footer>

</Layout>

<style>
  [data-fade] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.9s ease, transform 0.9s ease;
  }
  [data-fade].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Primary CTA — outlined gold, fills on hover */
  .cta-primary {
    transition: background-color 0.3s ease, color 0.3s ease;
    border: 1px solid #B8963E;
  }
  .cta-primary:hover {
    background: #B8963E;
    color: #0a0a08;
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-primary { transition: none; }
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    [data-fade] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>

<script>
  // Scroll fade-in — skipped entirely if user prefers reduced motion
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fadeEls = document.querySelectorAll('[data-fade]');

  if (prefersReducedMotion) {
    fadeEls.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const delay = el.dataset.fadeDelay ?? '0';
            el.style.transitionDelay = delay;
            el.classList.add('is-visible');
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.15 }
    );

    fadeEls.forEach((el, i) => {
      (el as HTMLElement).dataset.fadeDelay = `${i * 120}ms`;
      observer.observe(el);
    });
  }
</script>
