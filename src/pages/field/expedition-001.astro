---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Expedition 001 — Faloe Field · Western Ghats 2026"
  description="A ten-day wildlife film expedition in the coffee estates of Chikmagalur, Karnataka. Led by Amoghavarsha JS and Jonathan Whittaker. Twelve participants. October 2026."
>

  <!-- ─── NAV ─────────────────────────────────────────── -->
  <header class="fixed top-0 left-0 right-0 z-50 px-6 md:px-16 lg:px-24 xl:px-32 py-6 md:py-7 flex items-center justify-between" style="background: linear-gradient(to bottom, rgba(0,0,0,0.98) 0%, rgba(0,0,0,0.85) 80%, transparent 100%); backdrop-filter: blur(4px);">
    <a href="/" class="text-[#fdfcf8] uppercase select-none" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 22px; font-weight: 400; letter-spacing: 0.3em;">
      Faloe
    </a>
    <a
      href="/"
      class="text-[9px] md:text-[10px] uppercase font-light text-[#c8c5bc] hover:text-[#fdfcf8] transition-colors duration-300"
      style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.06em;"
    >
      ← Back
    </a>
  </header>

  <!-- ─── HERO ──────────────────────────────────────────── -->
  <section class="relative w-full h-[60vh] md:h-[90vh] overflow-hidden">

    <img
      src="/images/expedition/karnataka/karnataka-landscape-monsoon.jpg"
      alt="Forest ridge under monsoon clouds, Western Ghats, Karnataka"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />

    <div class="absolute inset-0" style="background: rgba(0,0,0,0.45);"></div>

    <div class="relative h-full flex flex-col items-center justify-center text-center px-8" data-fade>

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] font-light mb-6" style="font-family: 'Inter', system-ui, sans-serif;">
        Faloe Field &nbsp;&middot;&nbsp; Expedition 001
      </p>

      <h1
        class="font-light text-[#fdfcf8] leading-[0.95]"
        style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.75rem, 7vw, 6rem); letter-spacing: -0.03em;"
      >
        FALOE FIELD<br />EXPEDITION 001
      </h1>

      <p class="font-light text-[#c8c5bc] leading-[1.85] mt-6" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        Western Ghats &middot; Karnataka &middot; India<br />
        Ten days in October 2026
      </p>

      <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] opacity-50 mt-4" style="font-family: 'Inter', system-ui, sans-serif;">
        [ Exact dates confirmed upon enrollment ]
      </p>

    </div>

  </section>

  <div class="w-full h-px bg-[#fdfcf8] opacity-10"></div>

  <!-- ─── EXPEDITION OVERVIEW ───────────────────────────── -->
  <section data-fade class="px-8 md:px-16 lg:px-24 xl:px-32 py-24 md:py-32" style="background: #0a0a08;">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">

      <!-- Left: text -->
      <div>
        <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] font-light mb-8" style="font-family: 'Inter', system-ui, sans-serif;">
          The Expedition
        </p>

        <div class="space-y-6">
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            In the 17th century, a Sufi mystic named Baba Budan smuggled seven coffee beans out of Yemen and planted them in the hills above Chikmagalur, Karnataka. Against Ottoman law. Against everything. He started India's coffee industry. He may have saved a forest.
          </p>

          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            The shade-grown estates of the Western Ghats are one of the least understood ecosystems on earth: a working agricultural landscape that doubles as a wildlife corridor for tigers, leopards, Asian elephants, and hundreds of endemic species. The forest bleeds into the plantation. The plantation bleeds into the story. Most of this land has never been filmed.
          </p>

          <p class="italic text-[#fdfcf8] font-light leading-[1.2]" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.4rem, 2.5vw, 1.8rem);">
            Not a safari. Not a nature tour with a camera attached.
          </p>

          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Twelve filmmakers. Two leads who know this territory from the inside. A professional production crew. A film, made from beginning to end.
          </p>
        </div>
      </div>

      <!-- Right: image -->
      <div>
        <img src="/images/expedition/karnataka/karnataka-minivet-coffee.jpg" alt="Orange Minivet on coffee plant, Western Ghats" class="w-full rounded-[4px] object-cover" style="object-position: center 5%;">
        <p style="font-family: 'Inter', system-ui, sans-serif; font-size: 10px; letter-spacing: 0.2em;" class="text-[#c8c5bc] opacity-50 uppercase mt-3">© Amoghavarsha</p>
      </div>

    </div>

    <!-- Karnataka gallery -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mt-16">
      <img src="/images/expedition/karnataka/karnataka-landscape-monsoon.jpg" alt="Forest ridge under monsoon clouds, Western Ghats" class="w-full aspect-[4/3] rounded-[4px] object-cover" style="object-position: center 5%;">
      <img src="/images/expedition/karnataka/karnataka-leopard.jpg" alt="Leopard in the coffee estate undergrowth, Western Ghats" class="w-full aspect-[4/3] rounded-[4px] object-cover" style="object-position: center 5%;">
      <img src="/images/expedition/karnataka/karnataka-macaque.jpg" alt="Macaque in the forest canopy, Western Ghats" class="w-full aspect-[4/3] rounded-[4px] object-cover" style="object-position: center 5%;">
      <img src="/images/expedition/karnataka/karnataka-frog.jpg" alt="Endemic frog species, Western Ghats" class="w-full aspect-[4/3] rounded-[4px] object-cover col-span-2 md:col-span-3 md:aspect-[21/9]" style="object-position: right 5%;">
    </div>
    <p style="font-family: 'Inter', system-ui, sans-serif; font-size: 10px; letter-spacing: 0.2em;" class="text-[#c8c5bc] opacity-50 uppercase mt-3">© Amoghavarsha</p>

  </section>

  <div class="w-full h-px bg-[#fdfcf8] opacity-10"></div>

  <!-- ─── LEADS ─────────────────────────────────────────── -->
  <section data-fade class="px-8 md:px-16 lg:px-24 xl:px-32 py-24 md:py-32" style="background: #0a0a08;">

    <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] font-light mb-16" style="font-family: 'Inter', system-ui, sans-serif;">
      The Leads
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-20">

      <!-- Amoghavarsha -->
      <div>
        <img src="/images/expedition/headshots/amoghavarsha.jpeg" alt="Amoghavarsha JS" class="w-full aspect-[3/4] object-cover rounded-[4px] mb-8" style="object-position: left top;">

        <h3 class="font-light text-[#fdfcf8] leading-[0.95] mb-6" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.8rem, 3vw, 2.5rem); letter-spacing: -0.03em;">
          Amoghavarsha JS
        </h3>

        <div class="space-y-4">
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Wildlife filmmaker, conservationist, and photographer. Two decades in these forests.
          </p>
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Co-director of Wild Karnataka, India's first 4K blue-chip natural history film, narrated by Sir David Attenborough and distributed by BBC, Discovery, and Netflix. Winner of two National Film Awards. Art director on Divine Tides, the double Grammy-winning album by Ricky Kej and Stewart Copeland. His film Kali contributed directly to the renaming of a tiger reserve. His climate work was presented at the United Nations by two heads of state. Canon India EOS Ambassador.
          </p>
        </div>

        <div class="space-y-1 mt-6">
          <p class="italic text-[#B8963E] font-light" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem;">He knows where the animals are.</p>
          <p class="italic text-[#B8963E] font-light" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem;">He knows how to build a story in this landscape.</p>
          <p class="italic text-[#B8963E] font-light" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem;">He has been filming here for twenty years.</p>
        </div>
      </div>

      <!-- Jonathan Whittaker -->
      <div>
        <img src="/images/expedition/headshots/jonathan-whittaker.jpeg" alt="Jonathan Whittaker" class="w-full aspect-[3/4] object-cover object-top rounded-[4px] mb-8">

        <h3 class="font-light text-[#fdfcf8] leading-[0.95] mb-6" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.8rem, 3vw, 2.5rem); letter-spacing: -0.03em;">
          Jonathan Whittaker
        </h3>

        <div class="space-y-4">
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Filmmaker, producer, and educator. Twenty years of documentary and commercial work across six continents.
          </p>
          <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
            Producing credits include feature films and work for Sony Pictures, Sports Illustrated, DirecTV, and Nissan. Former Chair of the Short-Term Film Arts Department at the New York Film Academy. He has led field productions in Peru, South Africa, India, and across the Americas. His students work internationally.
          </p>
        </div>

        <div class="space-y-1 mt-6">
          <p class="italic text-[#B8963E] font-light" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem;">He runs the production.</p>
          <p class="italic text-[#B8963E] font-light" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem;">He builds the room.</p>
          <p class="italic text-[#B8963E] font-light" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem;">He has been in terrain like this before, and he knows what it takes to make something worth showing.</p>
        </div>
      </div>

    </div>

    <p class="font-light text-[#fdfcf8] italic text-center mb-16" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.5rem, 2.5vw, 2rem); letter-spacing: -0.03em;">
      Together: the territory and the craft.
    </p>

    <div class="max-w-[800px] mx-auto">
      <img src="/images/expedition/peru/peru-jonathan-teaching.jpeg" alt="Jonathan Whittaker teaching in the field" class="w-full rounded-[4px] object-cover">
    </div>

  </section>

  <div class="w-full h-px bg-[#fdfcf8] opacity-10"></div>

  <!-- ─── THE THREE PHASES ──────────────────────────────── -->
  <section data-fade class="px-8 md:px-16 lg:px-24 xl:px-32 py-24 md:py-32 bg-black">

    <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] font-light mb-16" style="font-family: 'Inter', system-ui, sans-serif;">
      The Three Phases
    </p>

    <div class="space-y-16">

      <!-- Phase 01 -->
      <div>
        <p class="font-light text-[#B8963E] leading-[1] mb-4" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(3rem, 6vw, 5rem);">01</p>
        <p class="font-light text-[#fdfcf8] text-[10px] tracking-[0.3em] uppercase mb-4" style="font-family: 'Inter', system-ui, sans-serif;">Virtual Pre-Production &nbsp;&middot;&nbsp; Two Weeks</p>
        <p class="font-light text-[#c8c5bc] leading-[1.85] max-w-[620px]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          Story development, shot-listing, and research. The Baba Budan narrative, the ecology of shade-grown coffee, the wildlife of the Western Ghats. The full cohort online with both leads before anyone boards a plane.
        </p>
        <p class="italic text-[#B8963E] font-light mt-4" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem;">
          You arrive in the field knowing what you are making.
        </p>
      </div>

      <!-- Phase 02 -->
      <div>
        <p class="font-light text-[#B8963E] leading-[1] mb-4" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(3rem, 6vw, 5rem);">02</p>
        <p class="font-light text-[#fdfcf8] text-[10px] tracking-[0.3em] uppercase mb-4" style="font-family: 'Inter', system-ui, sans-serif;">The Field &nbsp;&middot;&nbsp; Ten Days in October 2026</p>
        <p class="font-light text-[#c8c5bc] leading-[1.85] max-w-[620px]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          On-location production on the coffee estates and in the surrounding landscape. The light, the wildlife, the farmers, and the forest are all active ingredients in the work. Participants work alongside a professional production crew including a Director of Photography and a sound recordist.
        </p>
        <div class="space-y-1 mt-4">
          <p class="italic text-[#B8963E] font-light" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem;">The decisions are yours.</p>
          <p class="italic text-[#B8963E] font-light" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem;">The pressure is real.</p>
          <p class="italic text-[#B8963E] font-light" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem;">The footage is there if you can find it.</p>
        </div>
      </div>

      <!-- Phase 03 -->
      <div>
        <p class="font-light text-[#B8963E] leading-[1] mb-4" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(3rem, 6vw, 5rem);">03</p>
        <p class="font-light text-[#fdfcf8] text-[10px] tracking-[0.3em] uppercase mb-4" style="font-family: 'Inter', system-ui, sans-serif;">Post-Production &nbsp;&middot;&nbsp; Supervised</p>
        <p class="font-light text-[#c8c5bc] leading-[1.85] max-w-[620px]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
          Remote editing, colour, and sound with structured feedback sessions. An optional in-person residency in New York is available for participants who want to finish the cut in the room.
        </p>
      </div>

    </div>

    <div class="mt-20 grid grid-cols-1 md:grid-cols-2 gap-4 max-w-[900px] mx-auto justify-center">
      <img src="/images/expedition/peru/peru-jonathan-filming.jpeg" alt="Jonathan Whittaker filming on location, Peru" class="rounded-[4px] object-cover w-full aspect-[4/3]">
      <img src="/images/expedition/peru/peru-cohort-forest.jpeg" alt="Cohort in the forest, Peru" class="rounded-[4px] object-cover w-full aspect-[4/3]">
    </div>

  </section>

  <div class="w-full h-px bg-[#fdfcf8] opacity-10"></div>

  <!-- ─── WHAT YOU LEAVE WITH / DETAILS / CTA ───────────── -->
  <section data-fade class="px-8 md:px-16 lg:px-24 xl:px-32 py-24 md:py-32" style="background: #0a0a08;">

    <!-- Part one: What you leave with -->
    <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] font-light mb-8" style="font-family: 'Inter', system-ui, sans-serif;">
      What You Leave With
    </p>

    <div class="space-y-3 max-w-[620px]">
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        A finished film.
      </p>
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        Your footage, yours to use for portfolio, reel, website, and festival submissions.
      </p>
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        The experience of having made something difficult in a difficult place.
      </p>
    </div>

    <p class="italic text-[#c8c5bc] opacity-60 mt-2" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1rem;">
      Distribution of the finished film is managed jointly by Faloe and Indiverse.
    </p>

    <div class="mt-12 max-w-[700px]">
      <img src="/images/expedition/peru/peru-student-rocky-terrain.jpeg" alt="Student filming on rocky terrain, Peru" class="w-full rounded-[4px] object-cover aspect-[16/10]">
    </div>

    <div class="w-full h-px bg-[#fdfcf8] opacity-10 my-20"></div>

    <!-- Part two: The details -->
    <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] font-light mb-8" style="font-family: 'Inter', system-ui, sans-serif;">
      The Details
    </p>

    <p class="font-light text-[#fdfcf8] leading-[0.95] mb-8" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.5rem, 5vw, 4rem); letter-spacing: -0.03em;">
      $14,500
    </p>

    <div class="space-y-4 max-w-[620px]">
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        Expedition 001 is limited to twelve participants.
      </p>
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        Includes accommodation in Chikmagalur, ground transport within India, location access, and the complete pre-production and post-production framework.
      </p>
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        International flights and travel to your departure airport are not included in the program fee.
      </p>
      <p class="font-light text-[#c8c5bc] leading-[1.85]" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
        What it requires from you: commitment, seriousness about the work, and the ability to be in the Western Ghats in October 2026.
      </p>
    </div>

    <div class="w-full h-px bg-[#fdfcf8] opacity-10 my-20"></div>

    <!-- Part three: CTA -->
    <p class="font-light text-[#fdfcf8] leading-[0.95] mb-4" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.03em;">
      Applications are open.
    </p>

    <p class="font-light text-[#c8c5bc] mb-10" style="font-family: 'Inter', system-ui, sans-serif; font-size: 18px; letter-spacing: -0.01em;">
      The cohort fills by conversation, not by form.
    </p>

    <a
      href="https://faloefoundry.com/book"
      class="cta-primary inline-block text-[13px] font-light uppercase"
      style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.12em; padding: 18px 48px; background: transparent; color: #B8963E; text-decoration: none;"
    >
      Schedule a Consultation
    </a>

    <p class="text-[10px] tracking-[0.3em] uppercase text-[#c8c5bc] opacity-50 mt-8" style="font-family: 'Inter', system-ui, sans-serif;">
      Exact dates confirmed upon enrollment.
    </p>

  </section>

  <!-- ─── FOOTER ────────────────────────────────────────── -->
  <footer class="px-8 md:px-16 lg:px-24 xl:px-32 py-10 border-t border-[#fdfcf8] border-opacity-10">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <span class="text-[#fdfcf8] opacity-30" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 15px; letter-spacing: 0.2em;">
        Faloe
      </span>
      <div class="flex gap-8 text-[10px] uppercase font-light text-[#c8c5bc] opacity-30" style="font-family: 'Inter', system-ui, sans-serif; letter-spacing: 0.2em;">
        <span>New York</span>
        <span>&copy; 2026</span>
      </div>
    </div>
  </footer>

</Layout>

<style>
  [data-fade] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.9s ease, transform 0.9s ease;
  }
  [data-fade].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Primary CTA — outlined gold, fills on hover */
  .cta-primary {
    transition: background-color 0.3s ease, color 0.3s ease;
    border: 1px solid #B8963E;
  }
  .cta-primary:hover {
    background: #B8963E;
    color: #0a0a08;
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-primary { transition: none; }
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    [data-fade] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>

<script>
  // Scroll fade-in — skipped entirely if user prefers reduced motion
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fadeEls = document.querySelectorAll('[data-fade]');

  if (prefersReducedMotion) {
    fadeEls.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const delay = el.dataset.fadeDelay ?? '0';
            el.style.transitionDelay = delay;
            el.classList.add('is-visible');
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.15 }
    );

    fadeEls.forEach((el, i) => {
      (el as HTMLElement).dataset.fadeDelay = `${i * 120}ms`;
      observer.observe(el);
    });
  }
</script>
